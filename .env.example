# ==============================================================================
# UDBHAV Foundation Platform - Environment Configuration Template
# ==============================================================================
#
# DO NOT COMMIT SECRETS TO GIT.
# Copy this file to `.env.local` and populate it with real values for local dev.
#
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------------------
# The current deployment environment.
# Expected: "development" | "test" | "production"
NODE_ENV="development"

# The absolute URL where the application is hosted.
# Example: "http://localhost:3000" or "https://udbhavfoundation.in"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# SUPABASE (DATABASE & AUTH)
# ------------------------------------------------------------------------------
# The API URL of your Supabase project.
# Safe to expose to the client.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# The anonymous API key. Restricted by Row Level Security (RLS).
# Safe to expose to the client.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# The Service Role Key. Bypasses all RLS.
# EXTREMELY SENSITIVE. NEVER EXPOSE TO CLIENT OR LOG.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ------------------------------------------------------------------------------
# CLOUDFLARE R2 (STORAGE)
# ------------------------------------------------------------------------------
# The Cloudflare Account ID containing the R2 bucket.
# Sensitive. Never expose to client.
R2_ACCOUNT_ID="your-cloudflare-account-id"

# The R2 Access Key ID.
# Sensitive. Never expose to client.
R2_ACCESS_KEY_ID="your-r2-access-key"

# The R2 Secret Access Key.
# EXTREMELY SENSITIVE. NEVER EXPOSE TO CLIENT.
R2_SECRET_ACCESS_KEY="your-r2-secret-key"

# The exact name of the R2 bucket.
# Sensitive. Never expose to client.
R2_BUCKET_NAME="udbhav-dev-media"

# The public, custom domain URL used to serve images from the R2 bucket.
# Safe to expose to the client.
# Example: "https://media.udbhavfoundation.in"
NEXT_PUBLIC_R2_PUBLIC_URL="https://media.udbhavfoundation.in"

# ------------------------------------------------------------------------------
# GOOGLE INTEGRATIONS (Optional — Super Admin only)
# ------------------------------------------------------------------------------
# OAuth 2.0 Client credentials from Google Cloud Console.
# Required for Google Analytics, Search Console, and Ads integrations.
# NEVER prefix with NEXT_PUBLIC_. Server-only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# The OAuth callback URL registered in Google Cloud Console.
# Must match exactly. Default: https://udbhavfoundation.in/api/integrations/google/callback
GOOGLE_REDIRECT_URI="https://udbhavfoundation.in/api/integrations/google/callback"

# Encryption key for securing OAuth refresh tokens at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# EXTREMELY SENSITIVE. NEVER EXPOSE TO CLIENT.
INTEGRATION_SECRET_KEY=""

# Google Ads API Developer Token (optional, only for Google Ads integration).
# Apply at: https://developers.google.com/google-ads/api/docs/get-started/dev-token
GOOGLE_ADS_DEVELOPER_TOKEN=""
